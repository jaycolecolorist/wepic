# Copy this file to .env.local and fill in the values. Nothing here is secret except the API key.

# Public site address, used for SEO links, sitemap and social share previews.
# TODO: replace with the real domain once it is registered.
NEXT_PUBLIC_SITE_URL=https://wepic.qa

# WhatsApp number that receives bookings: country code + number, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=97433883327

# Email address that receives the "Send by Email" booking option.
NEXT_PUBLIC_CONTACT_EMAIL=Wepic.qa@gmail.com

# --- AI chat assistant -------------------------------------------------------
# Anthropic API key (https://console.anthropic.com). Server-side only: it is never sent to the browser.
# Leave empty to run the assistant in offline FAQ mode (answers from the built-in knowledge base).
ANTHROPIC_API_KEY=

# Claude model used by the assistant.
ANTHROPIC_MODEL=claude-opus-5

# Show the small dashed "Placeholder" badges on content that still needs real info
# (rental rates, studio size, testimonials, house rules...). Set to false only after replacing it all.
NEXT_PUBLIC_SHOW_PLACEHOLDER_BADGES=true
